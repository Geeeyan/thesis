API_PORT=4000
WEB_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
# Required. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=./server/villa-tjeozabel-app.sqlite

# Optional first-run staff/admin accounts. Set these before starting the API.
# They are created only if the email does not exist yet. Passwords need 8+ characters.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
STAFF_NAME=
STAFF_EMAIL=
STAFF_PASSWORD=

# Development mail catcher (Mailpit defaults). Start Mailpit locally and view
# captured messages at http://localhost:8025. For Gmail, replace these values
# with the settings below and use a Google App Password.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_ENCRYPTION=STARTTLS
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME=Villa Tjeozabel
# Gmail example: smtp.gmail.com, port 587, STARTTLS, Gmail username and App Password.
# For implicit TLS use port 465 and MAIL_ENCRYPTION=SSL.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=STARTTLS
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD=your-16-character-google-app-password
# MAIL_FROM_ADDRESS=your-account@gmail.com
# MAIL_FROM_NAME=Villa Tjeozabel
# Set MAIL_TIMEOUT_MS, MAIL_RETRY_COUNT, and MAIL_RETRY_DELAY_MS to tune delivery.
# Booking reminders are sent about this many hours before confirmed check-in.
BOOKING_REMINDER_HOURS=24

# Optional settings
CURRENCY=PHP
# Arrival times default to every whole hour, in the configured TIMEZONE.
# ARRIVAL_START_HOUR=0
# ARRIVAL_END_HOUR=23
# Same-day service starts are before this exclusive hour cutoff; default 12 allows starts through 11:00 AM.
# SAME_DAY_START_CUTOFF_HOUR=12
# Dates like "today" follow this timezone (defaults to the server's own)
# TIMEZONE=Asia/Manila
# Shown to guests after they choose how to pay. No card details are ever collected.
PAYMENT_INSTRUCTIONS_EWALLET=
PAYMENT_INSTRUCTIONS_BANK=
# Set to true when running behind a reverse proxy (nginx, Render, Railway...) so rate limits see real client IPs
# TRUST_PROXY=true
# UPLOAD_DIR=./server/uploads
# FRONTEND_BUILD_DIR=./build
