{
  "name": "villa-tjeozabel-backend",
  "version": "1.0.0",
  "description": "Villa Tjeozabel reservation API (Express + SQLite)",
  "main": "server/index.js",
  "scripts": {
    "start": "npm run build && node server/index.js",
    "build": "node scripts/build-frontend.js",
    "server": "node server/index.js",
    "dev": "node --watch server/index.js",
    "email:test": "node scripts/test-email.js",
    "test:frontend": "react-scripts test --watchAll=false --runInBand",
    "test:api": "node --test server/tests/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0",
    "react-scripts": "^5.0.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
